#!/usr/bin/bash
# Make /etc/group's 1Password groups match the fixed GIDs the image's setgid
# helpers are chgrp'd to (see files/scripts/1password-gids.sh in the repo).
# /etc/group persists across image updates and systemd-sysusers never
# renumbers an existing group, so an old or changed GID has to be fixed here.
set -euo pipefail

for spec in onepassword:1500 onepassword-cli:1501 onepassword-mcp:1502; do
    name=${spec%%:*}
    want=${spec##*:}
    cur=$(getent -s files group "$name" | cut -d: -f3 || true)
    if [[ -z "$cur" ]]; then
        groupadd -g "$want" "$name"
        echo "created $name with GID $want"
    elif [[ "$cur" != "$want" ]]; then
        groupmod -g "$want" "$name"
        echo "renumbered $name from GID $cur to $want"
    fi
done
