[Unit]
Description=Apply fixed GIDs to the 1Password groups
DefaultDependencies=no
After=systemd-sysusers.service local-fs.target
Before=systemd-user-sessions.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/onepassword-gids

[Install]
WantedBy=multi-user.target
